{
  "name": "acf-ggrc-receipt-server",
  "version": "1.0.0",
  "description": "Backend service for downloading GGRC Payment Receipts using Playwright",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
